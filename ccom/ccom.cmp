	component ccom is
		port (
			clk50_clk       : in std_logic                     := 'X';             -- clk
			reset_n_reset_n : in std_logic                     := 'X';             -- reset_n
			status_export   : in std_logic_vector(11 downto 0) := (others => 'X')  -- export
		);
	end component ccom;

