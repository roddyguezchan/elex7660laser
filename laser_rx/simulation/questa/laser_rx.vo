`timescale 1 ps/ 1 ps

module laser_rx (
	altera_reserved_tms,
	altera_reserved_tck,
	altera_reserved_tdi,
	altera_reserved_tdo,
	clk50,
	KEY,
	GPIO_0,
	GPIO_1);
input 	altera_reserved_tms;
input 	altera_reserved_tck;
input 	altera_reserved_tdi;
output 	altera_reserved_tdo;
input 	clk50;
input 	[1:0] KEY;
output 	[1:0] GPIO_0;
input 	[1:0] GPIO_1;

