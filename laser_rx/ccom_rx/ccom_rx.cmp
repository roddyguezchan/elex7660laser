	component ccom_rx is
		port (
			clk50_clk       : in std_logic                    := 'X';             -- clk
			datarx_export   : in std_logic_vector(7 downto 0) := (others => 'X'); -- export
			reset_n_reset_n : in std_logic                    := 'X'              -- reset_n
		);
	end component ccom_rx;

